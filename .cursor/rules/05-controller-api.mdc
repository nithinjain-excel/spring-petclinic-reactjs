## Adding New Endpoints

### Step 1: Update OpenAPI Specification
```yaml
# src/main/resources/openapi.yml
paths:
  /appointments:
    get:
      tags:
        - appointment
      operationId: listAppointments
      summary: Lists appointments
      responses:
        200:
          description: Appointments found
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Appointment'
    post:
      tags:
        - appointment
      operationId: addAppointment
      summary: Create appointment
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AppointmentFields'
      responses:
        201:
          description: Appointment created

components:
  schemas:
    Appointment:
      type: object
      properties:
        id:
          type: integer
        petId:
          type: integer
        vetId:
          type: integer
        scheduledAt:
          type: string
          format: date-time
    AppointmentFields:
      type: object
      properties:
        petId:
          type: integer
        vetId:
          type: integer
        scheduledAt:
          type: string
          format: date-time
```

### Step 2: Generate DTOs
```bash
mvn compile
```

### Step 3: Create Mapper
```java
@Mapper(uses = {PetMapper.class, VetMapper.class})
public interface AppointmentMapper {
    @Mapping(source = "pet.id", target = "petId")
    @Mapping(source = "vet.id", target = "vetId")
    AppointmentDto toAppointmentDto(Appointment appointment);
    
    Appointment toAppointment(AppointmentDto dto);
    Appointment toAppointment(AppointmentFieldsDto dto);
    List<AppointmentDto> toAppointmentDtos(Collection<Appointment> appointments);
}
```

### Step 4: Create Controller
```java
@RestController
@CrossOrigin(exposedHeaders = "errors, content-type")
@RequestMapping("/api")
public class AppointmentRestController implements AppointmentsApi {
    // Implementation following template above
}
```

