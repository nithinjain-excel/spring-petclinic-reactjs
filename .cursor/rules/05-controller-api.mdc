## MapStruct Mapper Pattern

```java
package org.springframework.samples.petclinic.mapper;

import org.mapstruct.Mapper;
import org.mapstruct.Mapping;
import org.springframework.samples.petclinic.model.Entity;
import org.springframework.samples.petclinic.rest.dto.EntityDto;
import org.springframework.samples.petclinic.rest.dto.EntityFieldsDto;

import java.util.Collection;
import java.util.List;

@Mapper(uses = {RelatedMapper.class})  // Include related mappers
public interface EntityMapper {

    EntityDto toEntityDto(Entity entity);

    Entity toEntity(EntityDto entityDto);

    Entity toEntity(EntityFieldsDto entityFieldsDto);

    List<EntityDto> toEntityDtos(Collection<Entity> entities);

    Collection<Entity> toEntities(Collection<EntityDto> entityDtos);

    // For nested ID mapping
    @Mapping(source = "parent.id", target = "parentId")
    EntityDto toEntityDtoWithParentId(Entity entity);
}
```

