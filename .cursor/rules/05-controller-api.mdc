## OpenAPI-First Development

### API Specification
- Location: `src/main/resources/openapi.yml`
- DTOs are auto-generated during `mvn compile`
- Controllers implement generated `*Api` interfaces

### Generated Packages
```
org.springframework.samples.petclinic.rest.api    # API interfaces
org.springframework.samples.petclinic.rest.dto    # DTO classes with Dto suffix
```

---

## Controller Template

```java
package org.springframework.samples.petclinic.rest.controller;

import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.samples.petclinic.mapper.EntityMapper;
import org.springframework.samples.petclinic.model.Entity;
import org.springframework.samples.petclinic.rest.api.EntitiesApi;
import org.springframework.samples.petclinic.rest.dto.EntityDto;
import org.springframework.samples.petclinic.rest.dto.EntityFieldsDto;
import org.springframework.samples.petclinic.service.ClinicService;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.util.UriComponentsBuilder;

import jakarta.transaction.Transactional;
import java.util.Collection;
import java.util.List;

@RestController
@CrossOrigin(exposedHeaders = "errors, content-type")
@RequestMapping("/api")
public class EntityRestController implements EntitiesApi {

    private final ClinicService clinicService;
    private final EntityMapper entityMapper;

    public EntityRestController(ClinicService clinicService, EntityMapper entityMapper) {
        this.clinicService = clinicService;
        this.entityMapper = entityMapper;
    }

    @PreAuthorize("hasRole(@roles.ENTITY_ADMIN)")
    @Override
    public ResponseEntity<List<EntityDto>> listEntities() {
        Collection<Entity> entities = this.clinicService.findAllEntities();
        if (entities.isEmpty()) {
            return new ResponseEntity<>(HttpStatus.NOT_FOUND);
        }
        return new ResponseEntity<>(entityMapper.toEntityDtos(entities), HttpStatus.OK);
    }

    @PreAuthorize("hasRole(@roles.ENTITY_ADMIN)")
    @Override
    public ResponseEntity<EntityDto> getEntity(Integer entityId) {
        Entity entity = this.clinicService.findEntityById(entityId);
        if (entity == null) {
            return new ResponseEntity<>(HttpStatus.NOT_FOUND);
        }
        return new ResponseEntity<>(entityMapper.toEntityDto(entity), HttpStatus.OK);
    }

    @PreAuthorize("hasRole(@roles.ENTITY_ADMIN)")
    @Override
    public ResponseEntity<EntityDto> addEntity(EntityFieldsDto entityFieldsDto) {
        HttpHeaders headers = new HttpHeaders();
        Entity entity = entityMapper.toEntity(entityFieldsDto);
        this.clinicService.saveEntity(entity);
        headers.setLocation(UriComponentsBuilder.newInstance()
            .path("/api/entities/{id}").buildAndExpand(entity.getId()).toUri());
        return new ResponseEntity<>(entityMapper.toEntityDto(entity), headers, HttpStatus.CREATED);
    }

    @PreAuthorize("hasRole(@roles.ENTITY_ADMIN)")
    @Override
    public ResponseEntity<EntityDto> updateEntity(Integer entityId, EntityFieldsDto entityFieldsDto) {
        Entity currentEntity = this.clinicService.findEntityById(entityId);
        if (currentEntity == null) {
            return new ResponseEntity<>(HttpStatus.NOT_FOUND);
        }
        currentEntity.setFieldName(entityFieldsDto.getFieldName());
        this.clinicService.saveEntity(currentEntity);
        return new ResponseEntity<>(entityMapper.toEntityDto(currentEntity), HttpStatus.NO_CONTENT);
    }

    @PreAuthorize("hasRole(@roles.ENTITY_ADMIN)")
    @Transactional
    @Override
    public ResponseEntity<EntityDto> deleteEntity(Integer entityId) {
        Entity entity = this.clinicService.findEntityById(entityId);
        if (entity == null) {
            return new ResponseEntity<>(HttpStatus.NOT_FOUND);
        }
        this.clinicService.deleteEntity(entity);
        return new ResponseEntity<>(HttpStatus.NO_CONTENT);
    }
}
```

