## Repository Interface Pattern

```java
package org.springframework.samples.petclinic.repository;

import org.springframework.dao.DataAccessException;
import org.springframework.samples.petclinic.model.Entity;
import java.util.Collection;

public interface EntityRepository {

    /**
     * Find entity by ID.
     * @param id the id to search for
     * @return the Entity if found
     * @throws DataAccessException if not found
     */
    Entity findById(int id) throws DataAccessException;

    /**
     * Retrieve all entities.
     * @return Collection of entities (or empty collection if none found)
     */
    Collection<Entity> findAll() throws DataAccessException;

    /**
     * Save (insert or update) entity.
     * @param entity the entity to save
     */
    void save(Entity entity) throws DataAccessException;

    /**
     * Delete entity.
     * @param entity the entity to delete
     */
    void delete(Entity entity) throws DataAccessException;

    /**
     * Find entities by field value.
     * @param value the value to search for
     * @return Collection of matching entities
     */
    Collection<Entity> findByFieldName(String value) throws DataAccessException;
}
```

